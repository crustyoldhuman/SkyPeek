										</ComboBox.ItemContainerStyle>
									</ComboBox>

									<TextBlock Grid.Row="2" Grid.Column="0" Text="City:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,12" ToolTip="Enter city, then select from the suggestions"/>
									<Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
										<TextBox x:Name="LocManCityInput" Background="{DynamicResource HoverBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{Binding BorderBrush, ElementName=WindowBorder}" Padding="4,2" TextChanged="LocManCityInput_TextChanged" ToolTip="Enter city, then select from the suggestions"/>
										<Popup x:Name="CitySuggestionsPopup" PlacementTarget="{Binding ElementName=LocManCityInput}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" MaxHeight="150">
											<Border Background="{DynamicResource ToastBackgroundBrush}" BorderBrush="{Binding BorderBrush, ElementName=WindowBorder}" BorderThickness="1" CornerRadius="4" Margin="0,2,0,0" MinWidth="{Binding ActualWidth, ElementName=LocManCityInput}">
												<ItemsControl x:Name="CitySuggestionsList">
													<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand" MouseLeftButtonUp="CitySuggestionItem_MouseLeftButtonUp" Tag="{Binding}" Padding="8,4" CornerRadius="2" Margin="2,1">
															<Border.Style>
																<Style TargetType="Border">
																	<Setter Property="Background" Value="Transparent" />
																	<Style.Triggers>
																		<Trigger Property="IsMouseOver" Value="True">
																			<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
																		</Trigger>
																		<Trigger Property="IsKeyboardFocused" Value="True">
																			<Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
																		</Trigger>
																	</Style.Triggers>
																</Style>
															</Border.Style>
															<TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" />
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</Border>
									</Popup>
								</Grid>

									<Border x:Name="AddLocation" Grid.Row="3" Grid.ColumnSpan="2" Background="Transparent" Margin="45,0,45,2" Cursor="Hand" MouseLeftButtonUp="AddLocation_MouseLeftButtonUp" Focusable="True" FocusVisualStyle="{DynamicResource GlobalFocusVisual}">
										<Grid HorizontalAlignment="Center">
										<TextBlock Text="Add location" FontSize="13" FontWeight="Bold" Visibility="Hidden"/>
										<TextBlock Text="Add location" FontSize="13" HorizontalAlignment="Center" Style="{StaticResource AddLocationTextStyle}"/>
									</Grid>
								</Border>
							</Grid>
						</Border>

						<ScrollViewer x:Name="SavedLocationsScroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" ScrollChanged="SavedLocationsScroller_ScrollChanged" Margin="0,-5,0,0" 
              local:SmoothScrollBehavior.IsEnabled="True" 
              local:SmoothScrollBehavior.ScrollStep="40.0" 
              local:ScrollFadeBehavior.IsEnabled="True"
              local:ScrollFadeBehavior.FadeDistance="40.0"
              local:ScrollFadeBehavior.FadeHeight="45.0">
							<StackPanel Margin="2,4,0,6">
								<ItemsControl x:Name="SavedLocationsList">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border x:Name="LocItemMainBorder" Background="{DynamicResource AgendaCardBackgroundBrush}" CornerRadius="4" Padding="8,4" AllowDrop="True" Drop="LocationItem_Drop" DragOver="LocationItem_DragOver" PreviewMouseLeftButtonDown="LocationItem_PreviewMouseLeftButtonDown" MouseMove="LocationItem_MouseMove" GiveFeedback="LocationItem_GiveFeedback" Tag="{Binding}" Focusable="True" FocusVisualStyle="{StaticResource InnerFocusVisual}">
													<Border.Style>
														<Style TargetType="Border">
															<Setter Property="Margin" Value="0,0,12,2"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding ScrollableHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="0">
																	<Setter Property="Margin" Value="0,0,2,2"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="Auto"/>
														<ColumnDefinition Width="Auto"/>
														<ColumnDefinition Width="Auto"/>
														<ColumnDefinition Width="Auto"/>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="8"/>
													</Grid.ColumnDefinitions>
														<Border x:Name="LocItemAlertBorder" Focusable="True" FocusVisualStyle="{DynamicResource GlobalFocusVisual}" Grid.Column="0" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ToggleLocationAlerts_MouseLeftButtonUp" Tag="{Binding}" Padding="1,2" Margin="-2,0,1,0" ToolTip="{Binding AlertFilterToolTip}" Visibility="{Binding AlertToggleVisibility}" Opacity="{Binding AlertToggleOpacity}">
															<Path Data="M 12,2 L 22,20 H 2 Z M 12,8 V 14 M 12,17 V 17.1" Stroke="{Binding AlertFilterColor}" StrokeThickness="1.25" Fill="Transparent" Stretch="Uniform" Width="14" Height="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Style="{StaticResource HoverGlowPath}"/>
													</Border>
														<Border x:Name="LocItemToneBorder" Focusable="True" FocusVisualStyle="{DynamicResource GlobalFocusVisual}" Grid.Column="1" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="ToggleLocationTone_MouseLeftButtonUp" Tag="{Binding}" Padding="1,2" Margin="0,0,1,0" ToolTip="{Binding ToneToolTip}" Visibility="{Binding ToneToggleVisibility}" Opacity="{Binding ToneOpacity}" IsHitTestVisible="{Binding IsToneInteractionEnabled}">
															<Path Data="M 12,22 c 1.1,0 2,-0.9 2,-2 h -4 c 0,1.1 0.9,2 2,2 z m 6,-6 v -5 c 0,-3.07 -1.63,-5.64 -4.5,-6.32 V 4 c 0,-0.83 -0.67 -1.5 -1.5,-1.5 c -0.83,0 -1.5,0.67 -1.5,1.5 v 0.68 C 7.64,5.36 6,7.92 6,11 v 5 l -2,2 v 1 h 16 v -1 l -2,-2 z" Fill="{Binding ToneIconColor}" Stretch="Uniform" Width="14" Height="14" Style="{StaticResource HoverGlowFillPath}"/>
													</Border>
														<Border x:Name="LocItemHomeBorder" Focusable="True" FocusVisualStyle="{DynamicResource GlobalFocusVisual}" Grid.Column="2" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="SetHomeLocation_MouseLeftButtonUp" Tag="{Binding}" Padding="1,2" Margin="0,0,1,0" ToolTip="{Binding HomeToolTip}">
															<Path Data="M 12,3 L 2,12 H 5 V 20 H 19 V 12 H 22 L 12,3 Z" Stretch="Uniform" Width="13" Height="13">
																<Path.Style>
																	<Style TargetType="Path" BasedOn="{StaticResource HoverGlowFillPath}">
																		<Setter Property="Fill" Value="#696969"/>
																		<Style.Triggers>
																			<DataTrigger Binding="{Binding IsHome}" Value="True">
																				<Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}"/>
																			</DataTrigger>
																		</Style.Triggers>
																	</Style>
																</Path.Style>
															</Path>
														</Border>
														<Border Grid.Column="3" Background="Transparent" Padding="1,2" Margin="0,0,2,0" ToolTip="Location managed by Windows" Visibility="{Binding WindowsLocationVisibility}">
														<Path Data="M12,2C8.13,2 5,5.13 5,9c0,5.25 7,13 7,13s7,-7.75 7,-13c0,-3.87 -3.13,-7 -7,-7zm0,9.5c-1.38,0 -2.5,-1.12 -2.5,-2.5s1.12,-2.5 2.5,-2.5s2.5,1.12 2.5,2.5s-1.12,2.5 -2.5,2.5z" Fill="{DynamicResource PrimaryTextBrush}" Stretch="Uniform" Width="12" Height="12"/>
													</Border>
													<Grid Grid.Column="4" ClipToBounds="True" SizeChanged="LocationMarquee_SizeChanged" Background="Transparent">
														<Canvas VerticalAlignment="Center" Height="16">
															<StackPanel Orientation="Horizontal" SizeChanged="LocationMarquee_SizeChanged" ToolTip="Click and drag to reorder">
																<StackPanel.RenderTransform>
																	<TranslateTransform X="0"/>
																</StackPanel.RenderTransform>
																<TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"/>
																<TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" Margin="20,0,0,0" Visibility="Collapsed"/>
															</StackPanel>
														</Canvas>
													</Grid>
														<Border x:Name="LocItemDeleteBorder" Focusable="True" FocusVisualStyle="{DynamicResource GlobalFocusVisual}" Grid.Column="5" Background="Transparent" HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonUp="RemoveLocation_MouseLeftButtonUp" Tag="{Binding}" Padding="0,0,0,0" Margin="0,0,-2,0" ToolTip="Remove location" Opacity="{Binding DeleteOpacity}">
															<Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="#CD5A5A" StrokeThickness="1.5" Stretch="Uniform" Width="7" Height="7" Style="{StaticResource HoverGlowPath}"/>
													</Border>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</ScrollViewer>

							<Grid Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="16" Margin="0,-15,-4,0" Panel.ZIndex="10" UseLayoutRounding="False">
								<Grid.Style>
									<Style TargetType="Grid">
										<Setter Property="Visibility" Value="Visible" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding ScrollableHeight, ElementName=SavedLocationsScroller}" Value="0">
												<Setter Property="Visibility" Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Grid.Style>
								<Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" IsHitTestVisible="False" Fill="{DynamicResource PrimaryTextBrush}">
									<Rectangle.OpacityMask>
										<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
											<GradientStop Color="Transparent" Offset="0.0" />
											<GradientStop Color="#40000000" Offset="0.5" />
											<GradientStop Color="Transparent" Offset="1.0" />
										</LinearGradientBrush>
									</Rectangle.OpacityMask>
								</Rectangle>
								<ScrollBar x:Name="SavedLocationsScrollBar" Orientation="Vertical"
                                       Minimum="0" 
                                       Maximum="{Binding ScrollableHeight, ElementName=SavedLocationsScroller, Mode=OneWay}"
                                       ViewportSize="{Binding ViewportHeight, ElementName=SavedLocationsScroller, Mode=OneWay}"
                                       Background="Transparent"
                                       BorderBrush="Transparent"
                                       Padding="0,15,0,15"
                                       ContextMenu="{x:Null}"
                                       Scroll="SavedLocationsScrollBar_Scroll"
                                       PreviewMouseLeftButtonDown="ScrollBar_PreviewMouseLeftButtonDown"
                                       Template="{StaticResource CustomScrollBarTemplate}" />
							</Grid>
						</Grid>
					</Grid>
				</Grid>
			</Grid>
		</Grid>
		<Border x:Name="ToastNotification" Background="{DynamicResource ToastBackgroundBrush}" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,75" Padding="15,8" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="100">
			<Border.Effect>
				<DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
			</Border.Effect>
			<TextBlock x:Name="ToastText" Text="Radar copied to clipboard" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"/>
		</Border>
	</Grid>
</Window>