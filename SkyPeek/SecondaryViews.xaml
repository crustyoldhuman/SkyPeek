<Window x:Class="SkyPeek.SecondaryViews"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:local="clr-namespace:SkyPeek"
            xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
            xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
            mc:Ignorable="d"
            Title="SecondaryViews" SizeToContent="WidthAndHeight"
            WindowStyle="None" AllowsTransparency="True" Background="Transparent"
			ShowInTaskbar="False" ResizeMode="NoResize" Deactivated="Window_Deactivated"
			Topmost="True" PreviewMouseDown="Window_PreviewMouseDown" PreviewMouseWheel="Window_PreviewMouseWheel"
            ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-2"
            local:SpatialNavigationBehavior.IsEnabled="True"
            UseLayoutRounding="{DynamicResource OsLayoutRounding}"
            TextOptions.TextFormattingMode="{DynamicResource OsTextFormattingMode}"
            TextOptions.TextRenderingMode="{DynamicResource OsTextRenderingMode}"
            RenderOptions.ClearTypeHint="Enabled">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="SlideoutResources.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<local:ActiveViewConverter x:Key="ActiveViewConverter" />
			<local:LottieToStaticConverter x:Key="LottieToStaticConverter" />

			<Style x:Key="InnerFocusVisual">
				<Setter Property="Control.Template">
					<Setter.Value>
						<ControlTemplate>
							<Border BorderThickness="2" 
                                    CornerRadius="4" 
                                    Margin="0" 
                                    Opacity="0.8"
                                    BorderBrush="{DynamicResource PrimaryTextBrush}" 
                                    Background="Transparent" 
                                    SnapsToDevicePixels="True"/>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</Window.Resources>
	<Grid Margin="25" Width="255" Height="390">
		<Grid.LayoutTransform>
			<ScaleTransform ScaleX="{Binding UI_Scale}" ScaleY="{Binding UI_Scale}"/>
		</Grid.LayoutTransform>
		<Grid.RenderTransform>
			<TranslateTransform x:Name="RootTransform"/>
		</Grid.RenderTransform>
		<Border x:Name="WindowBorder" CornerRadius="8" BorderBrush="#3E3E42" BorderThickness="1">
			<Border.Background>
				<RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
					<GradientStop x:Name="GradientCenter" Color="#FA38383D" Offset="0.0" />
					<GradientStop x:Name="GradientEdge" Color="#E6151518" Offset="1.0" />
				</RadialGradientBrush>
			</Border.Background>
			<Border.Effect>
				<DropShadowEffect x:Name="WindowShadow" Color="Black" BlurRadius="25" ShadowDepth="4" Direction="270" Opacity="0.9"/>
			</Border.Effect>
		</Border>


		<Grid x:Name="MainLayoutGrid" Margin="10" ClipToBounds="False">
			<Grid.RowDefinitions>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<Grid x:Name="LoadingView" Grid.Row="0" Panel.ZIndex="100" Opacity="0" IsHitTestVisible="False">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
					<Grid Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="{DynamicResource LoadingOpacity}" Background="{DynamicResource IconVignetteBrush}">
						<Border>
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="Visibility" Value="Visible"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding ViewModel.UseAnimatedIcons, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
											<Setter Property="Visibility" Value="Collapsed"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<lottie:LottieAnimationView x:Name="LoadingAnimation" ResourcePath="pack://application:,,,/IconAssets/SkyPeekLoadingAnimation.json" AutoPlay="True" RepeatCount="-1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
						</Border>
						<Image Source="{Binding Source='SkyPeekLoadingAnimation.json', Converter={StaticResource LottieToStaticConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
							<Image.Style>
								<Style TargetType="Image">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding ViewModel.UseAnimatedIcons, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Image.Style>
						</Image>
					</Grid>
					<TextBlock x:Name="LoadingMessageText" Text="{Binding LoadingText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="{DynamicResource LoadingOpacity}"/>
				</StackPanel>
			</Grid>

			<StackPanel x:Name="TabArea" Grid.Row="1" Orientation="Vertical" Background="Transparent" PreviewMouseWheel="TabArea_PreviewMouseWheel">
				<Rectangle Height="1" Width="230" Margin="0,4,0,6" Fill="{DynamicResource PrimaryTextBrush}">
					<Rectangle.OpacityMask>
						<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
							<GradientStop Color="Transparent" Offset="0.0" />
							<GradientStop Color="#60000000" Offset="0.5" />
							<GradientStop Color="Transparent" Offset="1.0" />
						</LinearGradientBrush>
					</Rectangle.OpacityMask>
				</Rectangle>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<Grid>
						<TextBlock Text="Current" FontSize="14" FontWeight="Bold" Visibility="Hidden"/>
						<TextBlock x:Name="TabCurrent" Text="Current" Tag="Selected" FontSize="14" Cursor="Hand" MouseLeftButtonUp="Tab_Click" Style="{StaticResource HoverGlowTab}" HorizontalAlignment="Center"/>
					</Grid>

					<Rectangle Width="1" Height="14" Margin="15,0,15,0" Fill="{DynamicResource PrimaryTextBrush}">
						<Rectangle.OpacityMask>
							<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
								<GradientStop Color="Transparent" Offset="0.0" />
								<GradientStop Color="#60000000" Offset="0.5" />
								<GradientStop Color="Transparent" Offset="1.0" />
							</LinearGradientBrush>
						</Rectangle.OpacityMask>
					</Rectangle>

					<Grid>
						<TextBlock Text="Hourly" FontSize="14" FontWeight="Bold" Visibility="Hidden"/>
						<TextBlock x:Name="TabHourly" Text="Hourly" Tag="Unselected" FontSize="14" Cursor="Hand" MouseLeftButtonUp="Tab_Click" Style="{StaticResource HoverGlowTab}" HorizontalAlignment="Center"/>
					</Grid>

					<Rectangle Width="1" Height="14" Margin="15,0,15,0" Fill="{DynamicResource PrimaryTextBrush}">
						<Rectangle.OpacityMask>
							<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
								<GradientStop Color="Transparent" Offset="0.0" />
								<GradientStop Color="#60000000" Offset="0.5" />
								<GradientStop Color="Transparent" Offset="1.0" />
							</LinearGradientBrush>
						</Rectangle.OpacityMask>
					</Rectangle>

					<Grid>
						<TextBlock Text="10-Day" FontSize="14" FontWeight="Bold" Visibility="Hidden"/>
						<TextBlock x:Name="Tab10Day" Text="Daily" Tag="Unselected" FontSize="14" Cursor="Hand" MouseLeftButtonUp="Tab_Click" Style="{StaticResource HoverGlowTab}" HorizontalAlignment="Center"/>
					</Grid>
				</StackPanel>
			</StackPanel>

			<Grid x:Name="ViewClipContainer" Grid.Row="0">
				<Image x:Name="TransitionOverlay" IsHitTestVisible="False" Visibility="Hidden" Panel.ZIndex="50" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Top"/>

				<Grid x:Name="ContentContainer">

					<local:CurrentViewControl x:Name="CurrentView" Visibility="{Binding CurrentActiveView, Converter={StaticResource ActiveViewConverter}, ConverterParameter=Current}"/>

					<Grid x:Name="SummaryView" Opacity="1.0" Visibility="{Binding CurrentActiveView, Converter={StaticResource ActiveViewConverter}, ConverterParameter=Summary}" Margin="0,0,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>

						<Grid Grid.Row="0" Margin="0,5,0,4">
							<Border x:Name="SummaryBackBorder" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="SummaryView_MouseLeftButtonUp" Padding="5,0,5,0" Focusable="True" FocusVisualStyle="{DynamicResource GlobalFocusVisual}" CornerRadius="6">
								<Path Data="M 10,2 L 4,7 L 10,12" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" Style="{StaticResource HoverGlowPath}">
								</Path>
							</Border>
							<TextBlock Text="Daily summary" Style="{StaticResource SoftShadowText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Grid>

						<ScrollViewer x:Name="SummaryScroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" local:SmoothScrollBehavior.IsEnabled="True" local:SmoothScrollBehavior.ScrollStep="40.0" local:ScrollFadeBehavior.IsEnabled="True" Focusable="True" Margin="0,0,-6,0" ScrollChanged="SummaryScroller_ScrollChanged">
							<ScrollViewer.FocusVisualStyle>
								<Style>
									<Setter Property="Control.Template">
										<Setter.Value>
											<ControlTemplate>
												<Grid SnapsToDevicePixels="True" Opacity="1.0" Margin="-10,-10,-4,2" IsHitTestVisible="False">
													<Grid.OpacityMask>
														<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
															<GradientStop Color="Transparent" Offset="0.0"/>
															<GradientStop Color="White" Offset="0.15"/>
															<GradientStop Color="White" Offset="0.85"/>
															<GradientStop Color="Transparent" Offset="1.0"/>
														</LinearGradientBrush>
													</Grid.OpacityMask>
													<Rectangle Height="1.5" VerticalAlignment="Top" Fill="{DynamicResource SecondaryTextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True" Margin="10,8,10,0" />
													<Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource SecondaryTextBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True" Margin="10,0,10,-7" />
												</Grid>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</ScrollViewer.FocusVisualStyle>
							<StackPanel Margin="5,0,15,0">
								<Grid Width="65" Height="65" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,4" Background="{DynamicResource IconVignetteBrush}">
									<Border>
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Visibility" Value="Visible"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding UseAnimatedIcons}" Value="False">
														<Setter Property="Visibility" Value="Collapsed"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<lottie:LottieAnimationView x:Name="SummaryIconAnimation" ResourcePath="{Binding CurrentWeather.IconPath, FallbackValue={x:Null}, TargetNullValue={x:Null}}" AutoPlay="True" RepeatCount="-1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
									</Border>
									<Image Source="{Binding CurrentWeather.IconPath, Converter={StaticResource LottieToStaticConverter}, FallbackValue={x:Null}, TargetNullValue={x:Null}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
										<Image.Style>
											<Style TargetType="Image">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding UseAnimatedIcons}" Value="False">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Image.Style>
									</Image>
								</Grid>
								<RichTextBox x:Name="SummaryText" Background="Transparent" BorderThickness="0" IsReadOnly="True" IsDocumentEnabled="True" Padding="0" Margin="0,0,0,25" VerticalAlignment="Top" FocusVisualStyle="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Disabled" Effect="{DynamicResource SoftTextShadowEffect}" TextOptions.TextFormattingMode="{DynamicResource OsTextFormattingMode}" TextOptions.TextRenderingMode="{DynamicResource OsTextRenderingMode}" RenderOptions.ClearTypeHint="Enabled">
									<FlowDocument TextAlignment="Center" LineHeight="18" FontSize="13" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource SecondaryTextBrush}">
										<Paragraph Margin="0">
											<Run Text="For"/>
											<Run Text="{Binding City, StringFormat='{}{0},', FallbackValue=--}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
											<Span local:WeatherService.FormattedText="{Binding CurrentWeather.DailySummary, FallbackValue=--}"/>
										</Paragraph>

										<BlockUIContainer Margin="0,14,0,12">
											<Rectangle Height="1" Width="180" HorizontalAlignment="Center" Fill="{DynamicResource PrimaryTextBrush}">
												<Rectangle.OpacityMask>
													<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
														<GradientStop Color="Transparent" Offset="0.0" />
														<GradientStop Color="#60000000" Offset="0.5" />
														<GradientStop Color="Transparent" Offset="1.0" />
													</LinearGradientBrush>
												</Rectangle.OpacityMask>
											</Rectangle>
										</BlockUIContainer>

										<Paragraph Margin="6,6,0,10" TextAlignment="Center">
											<Run Text="Air Quality Report" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold"/>
										</Paragraph>

										<Paragraph Margin="6,0,0,6" TextAlignment="Left">
											<Run Text="Primary Pollutant:" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold"/>
										</Paragraph>

										<Paragraph Margin="10,0,0,4" TextAlignment="Center">
											<Run Text="{Binding PrimaryPollutantHoverName, FallbackValue=--}" Foreground="{DynamicResource PrimaryTextBrush}" />
											<Run Text=" (" Foreground="{DynamicResource PrimaryTextBrush}" />
											<Run Text="{Binding PrimaryPollutantBaseName}" Foreground="{DynamicResource PrimaryTextBrush}" />
											<Run Text="{Binding PrimaryPollutantSubscript}" BaselineAlignment="Subscript" FontSize="10" Foreground="{DynamicResource PrimaryTextBrush}" />
											<Run Text="):" Foreground="{DynamicResource PrimaryTextBrush}" />
										</Paragraph>

										<Paragraph Margin="16,0,0,8" TextAlignment="Center" ToolTip="24-Hour Peak">
											<Run Text="{Binding PrimaryPollutantValue, FallbackValue=--}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" />
											<Run Text="{Binding PrimaryPollutantRating, StringFormat=' ({0})', FallbackValue=--}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" />
										</Paragraph>

										<Paragraph Margin="6,2,0,8" TextAlignment="Left">
											<Run Text="Secondary Pollutants:" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold"/>
										</Paragraph>

										<Table Margin="0,0,0,0" CellSpacing="0" TextAlignment="Center">
											<Table.Columns>
												<TableColumn />
												<TableColumn />
												<TableColumn />
												<TableColumn />
											</Table.Columns>
											<TableRowGroup>
												<TableRow>
													<TableCell Padding="6,0,6,0">
														<Paragraph Margin="0">
															<Span>
																<Span.ToolTip>
																	<ToolTip>
																		<TextBlock>
                                                                            <Run Text="{Binding SecondaryPollutants[0].HoverName}" FontWeight="SemiBold"/>
                                                                            <LineBreak/>
                                                                            <Run Text="{Binding SecondaryPollutants[0].Unit, StringFormat='24-Hour Peak ({0})'}" Foreground="{DynamicResource SecondaryTextBrush}"/>
																		</TextBlock>
																	</ToolTip>
																</Span.ToolTip>
																<Run Text="{Binding SecondaryPollutants[0].BaseName}" FontSize="12"/>
																<Run Text="{Binding SecondaryPollutants[0].Subscript}" BaselineAlignment="Subscript" FontSize="10"/>
															</Span>
														</Paragraph>
													</TableCell>
													<TableCell Padding="6,0,6,0">
														<Paragraph Margin="0">
															<Span>
																<Span.ToolTip>
																	<ToolTip>
																		<TextBlock>
                                                                            <Run Text="{Binding SecondaryPollutants[1].HoverName}" FontWeight="SemiBold"/>
                                                                            <LineBreak/>
                                                                            <Run Text="{Binding SecondaryPollutants[1].Unit, StringFormat='24-Hour Peak ({0})'}" Foreground="{DynamicResource SecondaryTextBrush}"/>
																		</TextBlock>
																	</ToolTip>
																</Span.ToolTip>
																<Run Text="{Binding SecondaryPollutants[1].BaseName}" FontSize="12"/>
																<Run Text="{Binding SecondaryPollutants[1].Subscript}" BaselineAlignment="Subscript" FontSize="10"/>
															</Span>
														</Paragraph>
													</TableCell>
													<TableCell Padding="6,0,6,0">
														<Paragraph Margin="0">
															<Span>
																<Span.ToolTip>
																	<ToolTip>
																		<TextBlock>
                                                                            <Run Text="{Binding SecondaryPollutants[2].HoverName}" FontWeight="SemiBold"/>
                                                                            <LineBreak/>
                                                                            <Run Text="{Binding SecondaryPollutants[2].Unit, StringFormat='24-Hour Peak ({0})'}" Foreground="{DynamicResource SecondaryTextBrush}"/>
																		</TextBlock>
																	</ToolTip>
																</Span.ToolTip>
																<Run Text="{Binding SecondaryPollutants[2].BaseName}" FontSize="12"/>
																<Run Text="{Binding SecondaryPollutants[2].Subscript}" BaselineAlignment="Subscript" FontSize="10"/>
															</Span>
														</Paragraph>
													</TableCell>
													<TableCell Padding="6,0,6,0">
														<Paragraph Margin="0">
															<Span>
																<Span.ToolTip>
																	<ToolTip>
																		<TextBlock>
                                                                            <Run Text="{Binding SecondaryPollutants[3].HoverName}" FontWeight="SemiBold"/>
                                                                            <LineBreak/>
                                                                            <Run Text="{Binding SecondaryPollutants[3].Unit, StringFormat='24-Hour Peak ({0})'}" Foreground="{DynamicResource SecondaryTextBrush}"/>
																		</TextBlock>
																	</ToolTip>
																</Span.ToolTip>
																<Run Text="{Binding SecondaryPollutants[3].BaseName}" FontSize="12"/>
																<Run Text="{Binding SecondaryPollutants[3].Subscript}" BaselineAlignment="Subscript" FontSize="10"/>
															</Span>
														</Paragraph>
													</TableCell>
												</TableRow>
												<TableRow>
													<TableCell Padding="6,0,6,0">
														<Paragraph Margin="0">
															<Run Text="{Binding SecondaryPollutants[0].PeakValue, FallbackValue=--}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
														</Paragraph>
													</TableCell>
													<TableCell Padding="6,0,6,0">
														<Paragraph Margin="0">
															<Run Text="{Binding SecondaryPollutants[1].PeakValue, FallbackValue=--}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
														</Paragraph>
													</TableCell>
													<TableCell Padding="6,0,6,0">
														<Paragraph Margin="0">
															<Run Text="{Binding SecondaryPollutants[2].PeakValue, FallbackValue=--}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
														</Paragraph>
													</TableCell>
													<TableCell Padding="6,0,6,0">
														<Paragraph Margin="0">
															<Run Text="{Binding SecondaryPollutants[3].PeakValue, FallbackValue=--}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"/>
														</Paragraph>
													</TableCell>
												</TableRow>
												<TableRow>
													<TableCell Padding="6,0,6,0">
														<Paragraph Margin="0">
															<Run Text="{Binding SecondaryPollutants[0].Rating, FallbackValue=--}" FontWeight="SemiBold" FontSize="12"/>
														</Paragraph>
													</TableCell>
													<TableCell Padding="6,0,6,0">
														<Paragraph Margin="0">
															<Run Text="{Binding SecondaryPollutants[1].Rating, FallbackValue=--}" FontWeight="SemiBold" FontSize="12"/>
														</Paragraph>
													</TableCell>
													<TableCell Padding="6,0,6,0">
														<Paragraph Margin="0">
															<Run Text="{Binding SecondaryPollutants[2].Rating, FallbackValue=--}" FontWeight="SemiBold" FontSize="12"/>
														</Paragraph>
													</TableCell>
													<TableCell Padding="6,0,6,0">
														<Paragraph Margin="0">
															<Run Text="{Binding SecondaryPollutants[3].Rating, FallbackValue=--}" FontWeight="SemiBold" FontSize="12"/>
														</Paragraph>
													</TableCell>
												</TableRow>
											</TableRowGroup>
										</Table>
									</FlowDocument>
								</RichTextBox>

							</StackPanel>
						</ScrollViewer>

						<Grid Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="16" Margin="0,0,-4,0" Panel.ZIndex="10" UseLayoutRounding="False">
							<Grid.Style>
								<Style TargetType="Grid">
									<Setter Property="Visibility" Value="Visible" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding ScrollableHeight, ElementName=SummaryScroller}" Value="0">
											<Setter Property="Visibility" Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Grid.Style>
							<Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" IsHitTestVisible="False" Fill="{DynamicResource PrimaryTextBrush}">
								<Rectangle.OpacityMask>
									<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
										<GradientStop Color="Transparent" Offset="0.0" />
										<GradientStop Color="#40000000" Offset="0.5" />
										<GradientStop Color="Transparent" Offset="1.0" />
									</LinearGradientBrush>
								</Rectangle.OpacityMask>
							</Rectangle>
							<ScrollBar x:Name="SummaryScrollBar" Orientation="Vertical"
                                       Minimum="0" 
                                       Maximum="{Binding ScrollableHeight, ElementName=SummaryScroller, Mode=OneWay}"
                                       ViewportSize="{Binding ViewportHeight, ElementName=SummaryScroller, Mode=OneWay}"
                                       Background="Transparent"
                                       BorderBrush="Transparent"
                                       Padding="0"
                                       ContextMenu="{x:Null}"
                                       Scroll="SummaryScrollBar_Scroll"
                                       PreviewMouseLeftButtonDown="ScrollBar_PreviewMouseLeftButtonDown"
                                       Template="{StaticResource CustomScrollBarTemplate}" />
						</Grid>
					</Grid>

					<local:HourlyViewControl x:Name="HourlyView" Visibility="{Binding CurrentActiveView, Converter={StaticResource ActiveViewConverter}, ConverterParameter=Hourly}" />

					<local:TenDayViewControl x:Name="TenDayView" Visibility="{Binding CurrentActiveView, Converter={StaticResource ActiveViewConverter}, ConverterParameter=10-Day}" />

				<Grid x:Name="RadarView" Opacity="1.0" Visibility="{Binding CurrentActiveView, Converter={StaticResource ActiveViewConverter}, ConverterParameter=Radar}" Margin="5,0,5,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

						<Grid Grid.Row="0" Margin="0,5,0,8" Panel.ZIndex="10">
							<Border x:Name="RadarBackBorder" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="RadarView_MouseLeftButtonUp" Padding="5,0,5,0" Focusable="True" FocusVisualStyle="{DynamicResource GlobalFocusVisual}" CornerRadius="6">
								<Path Data="M 10,2 L 4,7 L 10,12" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" Style="{StaticResource HoverGlowPath}">
							</Path>
						</Border>
						<TextBlock Text="Live radar" Style="{StaticResource SoftShadowText}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Grid>

						<Border x:Name="RadarPresentationBorder" Grid.Row="1" Margin="0,-4,0,8" Background="#18181B" Focusable="False">
							<Border.OpacityMask>
								<VisualBrush Stretch="Fill">
									<VisualBrush.Visual>
										<Border Background="White" CornerRadius="8" Width="225" Height="280" />
									</VisualBrush.Visual>
								</VisualBrush>
							</Border.OpacityMask>
							<Grid>
								<Border x:Name="RadarMapContainer" ClipToBounds="True" Background="#18181B">
									<Border.ToolTip>
										<ToolTip>
											<TextBlock>
											<Run Text="Last Update:"/>
											<LineBreak/>
