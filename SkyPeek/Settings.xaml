<Window x:Class="SkyPeek.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SkyPeek"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="SkyPeek Settings" Icon="pack://application:,,,/IconLogo.ico" Height="490" Width="690"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
		PreviewMouseDown="Window_PreviewMouseDown"
		PreviewMouseWheel="Window_PreviewMouseWheel"
		local:SpatialNavigationBehavior.IsEnabled="True"
        Opacity="0"
        SizeChanged="Window_SizeChanged"
        UseLayoutRounding="{DynamicResource OsLayoutRounding}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.ClearTypeHint="Enabled">

	<Grid Margin="25" RenderTransformOrigin="0.5,0.5">
		<Grid.Resources>
			<Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
				<Setter Property="FocusVisualStyle" Value="{StaticResource GlobalFocusVisual}"/>
			</Style>
			<Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
				<Setter Property="FocusVisualStyle" Value="{StaticResource GlobalFocusVisual}"/>
			</Style>
			<Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
				<Setter Property="FocusVisualStyle" Value="{StaticResource GlobalFocusVisual}"/>
				<Setter Property="SnapsToDevicePixels" Value="True"/>
				<Setter Property="UseLayoutRounding" Value="True"/>
			</Style>
			<Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
				<Setter Property="SnapsToDevicePixels" Value="True"/>
				<Setter Property="UseLayoutRounding" Value="True"/>
				<Style.Resources>
					<Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
						<Setter Property="Effect" Value="{x:Null}"/>
					</Style>
				</Style.Resources>
			</Style>
			<Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
				<Setter Property="FocusVisualStyle" Value="{StaticResource GlobalFocusVisual}"/>
			</Style>

			<Style TargetType="TextBlock">
				<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
				<Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
				<Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
				<Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
			</Style>

			<Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
				<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
				<Setter Property="FocusVisualStyle" Value="{StaticResource GlobalFocusVisual}"/>
			</Style>

			<Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
				<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
				<Setter Property="FocusVisualStyle" Value="{StaticResource RadioButtonFocusVisual}"/>
			</Style>

			<Style TargetType="ToolTip">
				<Setter Property="Placement" Value="Mouse"/>
				<Setter Property="VerticalOffset" Value="-60"/>
				<Setter Property="HorizontalOffset" Value="0"/>
				<Setter Property="Background" Value="{DynamicResource DynamicTooltipBackground}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource DynamicTooltipBorder}"/>

				<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
			</Style>
		</Grid.Resources>
		<Grid.RenderTransform>
			<ScaleTransform x:Name="WindowScale" ScaleX="0.85" ScaleY="0.85" />
		</Grid.RenderTransform>

		<Border x:Name="WindowBorder" CornerRadius="8" BorderBrush="#3E3E42" BorderThickness="1">
			<Border.Background>
				<RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
					<GradientStop x:Name="GradientCenter" Color="#FA38383D" Offset="0.0" />
					<GradientStop x:Name="GradientEdge" Color="#E6151518" Offset="1.0" />
				</RadialGradientBrush>
			</Border.Background>
			<Border.Effect>
				<DropShadowEffect x:Name="WindowShadow" Color="Black" BlurRadius="25" ShadowDepth="4" Direction="270" Opacity="0.9"/>
			</Border.Effect>
		</Border>
		<Grid x:Name="RootGrid" Background="Transparent" Focusable="True">
			<Viewbox Stretch="Uniform">
				<Grid Width="640" Height="440">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>

					<!-- Replaces the TitleBar's occupied space so the layout below doesn't shift -->
					<Border Height="32" />

					<TabControl x:Name="SettingsTabControl" Grid.Row="1" Margin="15,25,15,15" Background="Transparent" BorderThickness="0" PreviewMouseWheel="SettingsTabControl_PreviewMouseWheel">
						<TabControl.Resources>
					<Style x:Key="AnimatedTabContentStyle" TargetType="StackPanel">
						<Setter Property="Opacity" Value="0" />
						<Setter Property="RenderTransform">
							<Setter.Value>
								<TranslateTransform X="20" />
							</Setter.Value>
						</Setter>
						<Style.Triggers>
							<EventTrigger RoutedEvent="Loaded">
								<BeginStoryboard>
									<Storyboard>
										<DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
										<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="20" To="0" Duration="0:0:0.35">
											<DoubleAnimation.EasingFunction>
												<CubicEase EasingMode="EaseOut" />
											</DoubleAnimation.EasingFunction>
										</DoubleAnimation>
									</Storyboard>
								</BeginStoryboard>
							</EventTrigger>
						</Style.Triggers>
					</Style>
				</TabControl.Resources>
				<TabControl.Template>
					<ControlTemplate TargetType="TabControl">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="1*"/>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="2.75*"/>
							</Grid.ColumnDefinitions>
							<Border Grid.Column="0" Background="Transparent" Margin="0,0,15,0"/>
							<StackPanel Grid.Column="0" IsItemsHost="True" Margin="0,0,15,0"/>
									<Rectangle Grid.Column="1" Width="1" VerticalAlignment="Stretch" Margin="0,0,15,0" Fill="{DynamicResource PrimaryTextBrush}">
										<Rectangle.OpacityMask>
											<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
												<GradientStop Color="Transparent" Offset="0.0" />
												<GradientStop Color="#60000000" Offset="0.5" />
												<GradientStop Color="Transparent" Offset="1.0" />
											</LinearGradientBrush>
										</Rectangle.OpacityMask>
									</Rectangle>
									<ContentPresenter Grid.Column="2" ContentSource="SelectedContent" Margin="0,-20,0,0"/>
						</Grid>
					</ControlTemplate>
				</TabControl.Template>
						<TabControl.ItemContainerStyle>
							<Style TargetType="TabItem">
								<Setter Property="FocusVisualStyle">
									<Setter.Value>
										<Style>
											<Setter Property="Control.Template">
												<Setter.Value>
													<ControlTemplate>
														<Border BorderThickness="2" CornerRadius="8" Margin="-2" BorderBrush="{DynamicResource PrimaryTextBrush}" Background="Transparent" Opacity="0.8" SnapsToDevicePixels="True"/>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</Setter.Value>
								</Setter>
								<Setter Property="Padding" Value="22,8"/>
								<Setter Property="Margin" Value="0,0,0,6"/>
								<Setter Property="HorizontalAlignment" Value="Stretch"/>
								<Setter Property="Background" Value="Transparent"/>

								<Setter Property="TextElement.Foreground" Value="{DynamicResource SecondaryTextBrush}"/>

								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="TabItem">
											<Grid>
												<Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
													<Grid HorizontalAlignment="Left" VerticalAlignment="Center">
														<TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="Bold" Visibility="Hidden"/>

														<TextBlock x:Name="TabText" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Effect="{DynamicResource TabGlowEffect}" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" />
													</Grid>
												</Border>
											</Grid>
											<ControlTemplate.Triggers>
												<Trigger Property="IsSelected" Value="True">
													<Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
											<Setter TargetName="TabText" Property="FontWeight" Value="SemiBold"/>
										</Trigger>

												<Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
													<Setter Property="TextElement.Foreground" Value="White"/>
													<Setter TargetName="TabText" Property="FontWeight" Value="Bold"/>
													<Setter TargetName="TabText" Property="Effect" Value="{DynamicResource TabHoverGlowEffect}" />
												</Trigger>
											</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</TabControl.ItemContainerStyle>
				<TabItem Header="Alerts" Cursor="Hand">
					<StackPanel Style="{StaticResource AnimatedTabContentStyle}" Margin="10,0,0,0" Cursor="Arrow">
						<TextBlock Text="Alert settings" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" Margin="5,0,0,20"/>
						<CheckBox x:Name="EnableWeatherAlertsCheckbox" Content="Enable weather alerts" Cursor="Arrow" Margin="15,0,0,6"/>
						<StackPanel Margin="40,0,0,15" IsEnabled="{Binding IsChecked, ElementName=EnableWeatherAlertsCheckbox}" Cursor="Arrow">
							<StackPanel.Style>
								<Style TargetType="StackPanel">
									<Setter Property="Opacity" Value="1"/>
									<Style.Triggers>
										<Trigger Property="IsEnabled" Value="False">
											<Setter Property="Opacity" Value="0.5"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</StackPanel.Style>
							<CheckBox x:Name="EnableTrayAlertColorsCheckbox" Content="Enable home alert colors for system tray" Cursor="Arrow"/>
							<CheckBox x:Name="EnableAlertToneCheckbox" Content="Enable alert sound" VerticalAlignment="Top" Cursor="Arrow" Margin="0,6,0,0"/>
							<StackPanel Margin="40,10,0,10" IsEnabled="{Binding IsChecked, ElementName=EnableAlertToneCheckbox}" Cursor="Arrow">
								<StackPanel.Style>
									<Style TargetType="StackPanel">
										<Setter Property="Opacity" Value="1"/>
										<Style.Triggers>
											<Trigger Property="IsEnabled" Value="False">
												<Setter Property="Opacity" Value="0.5"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</StackPanel.Style>

								<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
									<ComboBox x:Name="AlertToneInput" Width="140" VerticalAlignment="Center" DropDownOpened="AlertToneInput_DropDownOpened" SelectionChanged="AlertToneInput_SelectionChanged"/>
									<Button x:Name="PlayToneButton" Click="PlayTonePreview_Click" Margin="5,0,0,0" VerticalAlignment="Center" Cursor="Hand">
										<Button.Template>
											<ControlTemplate TargetType="Button">
												<Border Background="Transparent" Padding="6">
													<Path x:Name="IconPath" Data="M 4 3 L 18 12 L 4 21 Z" Fill="{DynamicResource SecondaryTextBrush}" Stretch="Uniform" Width="16" Height="16"/>
												</Border>
												<ControlTemplate.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter TargetName="IconPath" Property="Fill" Value="White"/>
																<Setter TargetName="IconPath" Property="Effect" Value="{DynamicResource TabHoverGlowEffect}"/>
															</Trigger>
												</ControlTemplate.Triggers>
											</ControlTemplate>
										</Button.Template>
									</Button>
								</StackPanel>

								<TextBlock Text="Alert volume:" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Normal" VerticalAlignment="Center" Margin="0,6,10,8"/>
								<StackPanel Orientation="Horizontal">
											<Slider x:Name="AlertVolumeSlider" Width="220" Minimum="0.0" Maximum="1.0" Value="0.5" SmallChange="0.01" VerticalAlignment="Center" PreviewMouseLeftButtonDown="AlertVolumeSlider_PreviewMouseLeftButtonDown" PreviewMouseWheel="AlertVolumeSlider_PreviewMouseWheel"/>
											<TextBlock Text="{Binding Value, ElementName=AlertVolumeSlider, StringFormat={}{0:P0}}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="10,0,0,2"/>
								</StackPanel>
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</TabItem>
				<TabItem Header="Appearance" Cursor="Hand">
					<StackPanel Style="{StaticResource AnimatedTabContentStyle}" Margin="5,0,0,0" Cursor="Arrow" >
						<TextBlock Text="Appearance settings" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" Margin="10,0,0,20"/>
						<StackPanel Orientation="Horizontal" Margin="25,0,0,10" HorizontalAlignment="Left">
							<TextBlock Text="Theme:" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" FontWeight="Normal" Margin="0,4,15,0"/>
							<ComboBox x:Name="LightDarkSetting" Width="150" VerticalAlignment="Center" FontWeight="Normal" Margin="0,5,0,0" SelectionChanged="PreviewTheme_Changed" PreviewMouseWheel="ComboBox_DisableScroll"/>
						</StackPanel>
						<CheckBox x:Name="UseAccentColorCheckbox" Content="Use Windows theme accent colors" Cursor="Arrow" Margin="15,0,0,6" Click="PreviewTheme_Changed"/>
						<CheckBox x:Name="UseTransparencyCheckbox" Content="Disable window transparency" Cursor="Arrow" Margin="15,0,0,6" Click="PreviewTheme_Changed"/>
						<CheckBox x:Name="UseAnimatedIcons" Content="Use animated weather icons (GPU intensive)" Cursor="Arrow" Margin="15,0,0,15"/>
						<TextBlock Text="Scale weather window:" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Normal" Margin="25,5,0,12" />
						<StackPanel Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Center" >
							<Slider x:Name="SlideoutScaleSlider" Minimum="0.4" Maximum="3.0" Width="250" VerticalAlignment="Center"
ValueChanged="SlideoutScaleSlider_ValueChanged"
Thumb.DragStarted="SlideoutScaleSlider_DragStarted"
Thumb.DragCompleted="SlideoutScaleSlider_DragCompleted"
PreviewMouseLeftButtonDown="SlideoutScaleSlider_PreviewMouseLeftButtonDown"
PreviewMouseWheel="SlideoutScaleSlider_PreviewMouseWheel"/>
							<TextBlock Text="{Binding Value, ElementName=SlideoutScaleSlider, StringFormat={}{0:F2}x}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
						</StackPanel>
					</StackPanel>
				</TabItem>
				<TabItem Header="Behavior" Cursor="Hand">
					<StackPanel Style="{StaticResource AnimatedTabContentStyle}" Margin="5,0,0,0" Cursor="Arrow" >
						<TextBlock Text="Behavior settings" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" Margin="10,0,0,20"/>
						<CheckBox x:Name="EnableHotkeyCheckbox" Content="Enable SkyPeek pop-up" Margin="20,0,0,10" Cursor="Arrow" ToolTip="Enables a system-wide pop-up weather window on keypress"/>
						<StackPanel Orientation="Horizontal" Margin="20,0,0,6" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=EnableHotkeyCheckbox}">
							<StackPanel.Style>
								<Style TargetType="StackPanel">
									<Setter Property="Opacity" Value="1"/>
									<Style.Triggers>
										<Trigger Property="IsEnabled" Value="False">
											<Setter Property="Opacity" Value="0.5"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</StackPanel.Style>
							<TextBlock Text="Keyboard shortcut:" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="45,0,6,0" FontWeight="Normal" ToolTip="Program the hotkey to open the SkyPeek pop-up"/>
							<TextBox x:Name="HotkeyInput" Width="150" IsReadOnly="True" Margin="10,0,0,0" PreviewKeyDown="HotkeyInput_PreviewKeyDown">
								<TextBox.Style>
									<Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
										<Setter Property="ToolTip" Value="Click here and press the desired key combination"/>
										<Style.Triggers>
											<Trigger Property="IsKeyboardFocused" Value="True">
												<Setter Property="ToolTip" Value="Press enter to input your key combination"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</TextBox.Style>
							</TextBox>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="45,0,0,15" HorizontalAlignment="Left" IsEnabled="{Binding IsChecked, ElementName=EnableHotkeyCheckbox}">
							<StackPanel.Style>
								<Style TargetType="StackPanel">
									<Setter Property="Opacity" Value="1"/>
									<Style.Triggers>
										<Trigger Property="IsEnabled" Value="False">
											<Setter Property="Opacity" Value="0.5"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</StackPanel.Style>
							<TextBlock Text="Pop-up position:" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Normal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="20,5,10,0" ToolTip="Customize the spawn location of the pop-up"/>
							<RadioButton x:Name="BottomRadio" Content="Bottom" Foreground="{DynamicResource PrimaryTextBrush}" GroupName="PopupPos" VerticalAlignment="Center" Margin="5,5,15,0"/>
							<RadioButton x:Name="TopRadio" Content="Top" Foreground="{DynamicResource PrimaryTextBrush}" GroupName="PopupPos" VerticalAlignment="Center" Margin="0,5,0,0"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="30,0,0,15" HorizontalAlignment="Left" ToolTip="Select which tab is shown when you open the SkyPeek slideout">
							<TextBlock Text="Default tab view:" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" FontWeight="Normal" Margin="0,4,15,0"/>
							<ComboBox x:Name="DefaultViewInput" Width="150" VerticalAlignment="Center" FontWeight="Normal" Margin="0,5,0,0"/>
						</StackPanel>
						<CheckBox x:Name="UseAnimationsCheckbox" Content="Disable open/close window animations" Cursor="Arrow" Margin="20,0,0,6"/>
					</StackPanel>
				</TabItem>
				<TabItem Header="Units &amp; time" Cursor="Hand">
					<StackPanel Style="{StaticResource AnimatedTabContentStyle}" Margin="10,0,0,0">
						<TextBlock Text="Units &amp; time settings" Cursor="Arrow" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" Margin="5,0,0,20"/>
						<CheckBox x:Name="CelsiusCheckbox" Content="Convert Fahrenheit to Celsius" Cursor="Arrow" Margin="15,0,0,6"/>
						<CheckBox x:Name="UseKphCheckbox" Content="Convert mph to kph" Cursor="Arrow" Margin="15,0,0,6"/>
						<CheckBox x:Name="UseCmCheckbox" Content="Convert inches to centimeters" Cursor="Arrow" Margin="15,0,0,6"/>
						<CheckBox x:Name="FlipWindArrowCheckbox" Content="Point wind arrow towards source of wind" Cursor="Arrow" Margin="15,0,0,6"/>
						<CheckBox x:Name="Use24HourClockCheckbox" Content="Use 24-Hour clock" Cursor="Arrow" Margin="15,0,0,15"/>
					</StackPanel>
				</TabItem>
				<TabItem Header="System" Cursor="Hand">
					<StackPanel Style="{StaticResource AnimatedTabContentStyle}" Margin="10,0,0,0" Cursor="Arrow">
						<TextBlock Text="System settings" FontSize="18" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" Margin="5,0,0,20"/>
						<CheckBox x:Name="StartupCheckbox" Content="Start SkyPeek on system boot" Margin="15,0,0,6"/>
						<CheckBox x:Name="WindowsLocationCheckbox" Content="Sync GPS from Windows to location list" Margin="15,0,0,6"/>
						<StackPanel Orientation="Horizontal" Margin="25,15,0,10">
							<TextBlock Text="Refresh interval (mins):" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" FontWeight="Normal" Margin="0,0,15,0" ToolTip="15 minute minimum"/>
							<ui:NumberBox x:Name="IntervalInput" Value="30" Minimum="15" ClearButtonEnabled="False" Width="125" VerticalAlignment="Center" TextChanged="IntervalInput_TextChanged" PreviewMouseDown="IntervalInput_PreviewMouseDown" FocusVisualStyle="{StaticResource GlobalFocusVisual}"/>
						</StackPanel>
						<StackPanel Orientation="Horizontal" Margin="25,30,0,0">
							<ui:Button x:Name="ExportSettingsButton" Content="Export settings..." Margin="0,0,10,0" Width="130" Click="ExportSettings_Click" FocusVisualStyle="{StaticResource GlobalFocusVisual}"/>
							<ui:Button x:Name="ImportSettingsButton" Content="Import settings..." Width="130" Click="ImportSettings_Click" FocusVisualStyle="{StaticResource GlobalFocusVisual}"/>
						</StackPanel>
					</StackPanel>
				</TabItem>
			</TabControl>
			<ui:Button x:Name="SaveSettingsButton" Content="Save &amp; close" Grid.Row="2" HorizontalAlignment="center" Width="120" Margin="0,0,0,30" Click="SaveButton_Click" FocusVisualStyle="{StaticResource GlobalFocusVisual}"/>
			<TextBlock x:Name="HelpFileTextBlock" Focusable="True" Background="Transparent" FocusVisualStyle="{StaticResource GlobalFocusVisual}" Text="Help &amp; info" FontSize="12" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,28" Cursor="Hand" MouseLeftButtonUp="HelpFile_MouseLeftButtonUp">
				<TextBlock.Style>
					<Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
						<Setter Property="Foreground" Value="{DynamicResource AppInfoTextBrush}" />
						<Style.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
										<Setter Property="Effect" Value="{DynamicResource TabHoverGlowEffect}" />
									</Trigger>
									<Trigger Property="IsKeyboardFocused" Value="True">
										<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
										<Setter Property="Effect" Value="{DynamicResource TabHoverGlowEffect}" />
									</Trigger>
								</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
					<TextBlock x:Name="AppInfoTextBlock" Focusable="True" Background="Transparent" FocusVisualStyle="{StaticResource GlobalFocusVisual}" Text="Credits" FontSize="12" Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,10" Cursor="Hand" MouseLeftButtonUp="AppInfo_MouseLeftButtonUp">
						<TextBlock.Style>
					<Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
						<Setter Property="Foreground" Value="{DynamicResource AppInfoTextBrush}" />
								<Style.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
										<Setter Property="Effect" Value="{DynamicResource TabHoverGlowEffect}"/>
									</Trigger>
									<Trigger Property="IsKeyboardFocused" Value="True">
										<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
										<Setter Property="Effect" Value="{DynamicResource TabHoverGlowEffect}"/>
									</Trigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</Grid>
			</Viewbox>

			<ui:TitleBar x:Name="TopTitleBar" Title="SkyPeek Settings" VerticalAlignment="Top" HorizontalAlignment="Stretch" ShowMaximize="False">
				<ui:TitleBar.Icon>
					<ui:ImageIcon Source="pack://application:,,,/IconLogo.ico" Width="16" Height="16" Margin="20,0,-4,0"/>
				</ui:TitleBar.Icon>
				<ui:TitleBar.OpacityMask>
					<VisualBrush>
						<VisualBrush.Visual>
							<!-- Masks the title bar to an inner radius of 7px (8px WindowBorder minus 1px BorderThickness) -->
							<Border Background="Black" CornerRadius="7,7,0,0" 
                                    Width="{Binding ActualWidth, ElementName=TopTitleBar}" 
                                    Height="{Binding ActualHeight, ElementName=TopTitleBar}"/>
						</VisualBrush.Visual>
					</VisualBrush>
				</ui:TitleBar.OpacityMask>
			</ui:TitleBar>

			<Thumb Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" Background="Transparent" Margin="0,0,6,6" Opacity="0.5">
				<Thumb.Template>
					<ControlTemplate TargetType="{x:Type Thumb}">
						<Border Background="{TemplateBinding Background}">
							<Path Data="M 6,16 L 16,6 M 11,16 L 16,11" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.5" StrokeEndLineCap="Round" StrokeStartLineCap="Round" VerticalAlignment="Bottom" HorizontalAlignment="Right" Effect="{DynamicResource BaseTextShadowEffect}"/>
						</Border>
					</ControlTemplate>
				</Thumb.Template>
			</Thumb>
		</Grid>
		<Border x:Name="SettingsToastNotification" Background="{DynamicResource ToastBackgroundBrush}" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,75" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="100" Effect="{DynamicResource BaseTextShadowEffect}">
			<Grid>
				<Grid.OpacityMask>
					<VisualBrush>
						<VisualBrush.Visual>
							<Border Background="White" CornerRadius="6" Width="{Binding ActualWidth, ElementName=SettingsToastNotification}" Height="{Binding ActualHeight, ElementName=SettingsToastNotification}"/>
						</VisualBrush.Visual>
					</VisualBrush>
				</Grid.OpacityMask>
				<Border Background="{DynamicResource HoverBackgroundBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
					<Border.RenderTransform>
						<ScaleTransform x:Name="SettingsToastScale" ScaleX="1"/>
					</Border.RenderTransform>
				</Border>
				<TextBlock x:Name="SettingsToastText" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220" Margin="15,8,15,10"/>
			</Grid>
		</Border>
	</Grid>
</Window>