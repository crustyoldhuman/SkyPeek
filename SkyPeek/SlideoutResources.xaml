<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SkyPeek">

	<local:SingleWordVisibilityConverter x:Key="SingleWordVisibilityConverter"/>
	<local:ActiveViewConverter x:Key="ActiveViewConverter"/>
	<BooleanToVisibilityConverter x:Key="BoolToVis" />

	<Style x:Key="GlobalFocusVisual">
		<Setter Property="Control.Template">
			<Setter.Value>
				<ControlTemplate>
					<Border BorderThickness="2" 
                            CornerRadius="3" 
                            Margin="-4" 
                            Opacity="0.8"
                            BorderBrush="{DynamicResource PrimaryTextBrush}" 
                            Background="Transparent" 
                            SnapsToDevicePixels="True"/>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="HoverGlowTab" TargetType="TextBlock">
		<Setter Property="Focusable" Value="True"/>
		<Setter Property="FocusVisualStyle" Value="{StaticResource GlobalFocusVisual}"/>
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
		<Setter Property="Effect" Value="{DynamicResource TabGlowEffect}" />
		<Setter Property="TextOptions.TextFormattingMode" Value="{DynamicResource OsTextFormattingMode}" />
		<Setter Property="TextOptions.TextRenderingMode" Value="{DynamicResource OsTextRenderingMode}" />
		<Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
		<Style.Triggers>
			<Trigger Property="Tag" Value="Selected">
				<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
				<Setter Property="FontWeight" Value="Bold" />
			</Trigger>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}" />
				<Setter Property="Effect" Value="{DynamicResource TabHoverGlowEffect}" />
				<Setter Property="FontWeight" Value="Bold" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="HoverGlowPath" TargetType="Path">
		<Setter Property="Stroke" Value="{DynamicResource SecondaryTextBrush}" />
		<Setter Property="Effect" Value="{DynamicResource TabGlowEffect}" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
				<Setter Property="Stroke" Value="{DynamicResource PrimaryTextBrush}" />
				<Setter Property="Effect" Value="{DynamicResource TabHoverGlowEffect}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="HoverGlowFillPath" TargetType="Path">
		<Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
		<Setter Property="Effect" Value="{DynamicResource TabGlowEffect}" />
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
				<Setter Property="Fill" Value="{DynamicResource PrimaryTextBrush}" />
				<Setter Property="Effect" Value="{DynamicResource TabHoverGlowEffect}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="BaseShadowText" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
		<Setter Property="Effect" Value="{DynamicResource BaseTextShadowEffect}" />
		<Setter Property="TextOptions.TextFormattingMode" Value="{DynamicResource OsTextFormattingMode}" />
		<Setter Property="TextOptions.TextRenderingMode" Value="{DynamicResource OsTextRenderingMode}" />
		<Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
	</Style>

	<Style TargetType="TextBlock" BasedOn="{StaticResource BaseShadowText}"/>

	<Style TargetType="ToolTip">
		<Setter Property="Placement" Value="Mouse"/>
		<Setter Property="VerticalOffset" Value="-45"/>
		<Setter Property="HorizontalOffset" Value="0"/>
		<Setter Property="Background" Value="{DynamicResource DynamicTooltipBackground}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource DynamicTooltipBorder}"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
	</Style>

	<Style x:Key="SoftShadowText" TargetType="TextBlock" BasedOn="{StaticResource BaseShadowText}">
		<Setter Property="Effect" Value="{DynamicResource SoftTextShadowEffect}" />
	</Style>

	<Style x:Key="AddLocationTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseShadowText}">
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
		<Style.Triggers>
			<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
				<Setter Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
				<Setter Property="FontWeight" Value="Bold"/>
				<Setter Property="Effect" Value="{DynamicResource TabHoverGlowEffect}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<ControlTemplate x:Key="RadarScrubberTemplate" TargetType="Slider">
		<Grid Background="{TemplateBinding Background}">
			<Track x:Name="PART_Track">
				<Track.DecreaseRepeatButton>
					<RepeatButton Command="{x:Static Slider.DecreaseLarge}">
						<RepeatButton.Template>
							<ControlTemplate TargetType="RepeatButton">
								<Border Background="Transparent" />
							</ControlTemplate>
						</RepeatButton.Template>
					</RepeatButton>
				</Track.DecreaseRepeatButton>
				<Track.IncreaseRepeatButton>
					<RepeatButton Command="{x:Static Slider.IncreaseLarge}">
						<RepeatButton.Template>
							<ControlTemplate TargetType="RepeatButton">
								<Border Background="Transparent" />
							</ControlTemplate>
						</RepeatButton.Template>
					</RepeatButton>
				</Track.IncreaseRepeatButton>
				<Track.Thumb>
					<Thumb Cursor="Hand">
						<Thumb.Template>
							<ControlTemplate TargetType="Thumb">
								<Border x:Name="ThumbBorder" Width="16" Height="12" CornerRadius="6" Background="{DynamicResource PrimaryTextBrush}">
									<Border.Effect>
										<DropShadowEffect Color="{DynamicResource PrimaryShadowColor}" BlurRadius="4" ShadowDepth="1" Opacity="0.5" />
									</Border.Effect>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="ThumbBorder" Storyboard.TargetProperty="Height" To="16" Duration="0:0:0.1" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="ThumbBorder" Storyboard.TargetProperty="Height" To="12" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Thumb.Template>
					</Thumb>
				</Track.Thumb>
			</Track>
		</Grid>
	</ControlTemplate>

	<ControlTemplate x:Key="CustomScrollBarTemplate" TargetType="ScrollBar">
		<Grid Background="Transparent">
			<Track x:Name="PART_Track" IsDirectionReversed="True" Margin="{TemplateBinding Padding}">
				<Track.DecreaseRepeatButton>
					<RepeatButton Command="{x:Static ScrollBar.PageUpCommand}">
						<RepeatButton.Template>
							<ControlTemplate TargetType="RepeatButton">
								<Border Background="Transparent" />
							</ControlTemplate>
						</RepeatButton.Template>
					</RepeatButton>
				</Track.DecreaseRepeatButton>
				<Track.IncreaseRepeatButton>
					<RepeatButton Command="{x:Static ScrollBar.PageDownCommand}">
						<RepeatButton.Template>
							<ControlTemplate TargetType="RepeatButton">
								<Border Background="Transparent" />
							</ControlTemplate>
						</RepeatButton.Template>
					</RepeatButton>
				</Track.IncreaseRepeatButton>
				<Track.Thumb>
					<Thumb Cursor="Hand">
						<Thumb.Template>
							<ControlTemplate TargetType="Thumb">
								<Border x:Name="ThumbBorder" Width="4" MinHeight="32" CornerRadius="6" Background="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Opacity="0.6">
									<Border.Effect>
										<DropShadowEffect Color="{DynamicResource PrimaryShadowColor}" BlurRadius="4" ShadowDepth="1" Opacity="0.5" />
									</Border.Effect>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="ThumbBorder" Storyboard.TargetProperty="Width" To="6" Duration="0:0:0.1" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="ThumbBorder" Storyboard.TargetProperty="Width" To="4" Duration="0:0:0.15" />
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Thumb.Template>
					</Thumb>
				</Track.Thumb>
			</Track>
		</Grid>
	</ControlTemplate>
</ResourceDictionary>