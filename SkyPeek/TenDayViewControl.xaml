<UserControl x:Class="SkyPeek.TenDayViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SkyPeek"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="SlideoutResources.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid>
		<Grid x:Name="TenDayViewGrid" Margin="0,0,0,-15">
			<Rectangle Height="1" Width="180" VerticalAlignment="Bottom" Margin="0,0,0,25" Fill="{DynamicResource PrimaryTextBrush}">
				<Rectangle.OpacityMask>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Color="Transparent" Offset="0.0" />
						<GradientStop Color="#40000000" Offset="0.5" />
						<GradientStop Color="Transparent" Offset="1.0" />
					</LinearGradientBrush>
				</Rectangle.OpacityMask>
			</Rectangle>

			<Grid x:Name="KeyboardHighlightGroup" IsHitTestVisible="False" SnapsToDevicePixels="True" Opacity="0.7" Panel.ZIndex="1">
				<Grid.Style>
					<Style TargetType="Grid">
						<Setter Property="Visibility" Value="Collapsed"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TenDayItemsControl}" Value="True">
								<Setter Property="Visibility" Value="Visible"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
				<Grid.OpacityMask>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Color="Transparent" Offset="0.0"/>
						<GradientStop Color="White" Offset="0.15"/>
						<GradientStop Color="White" Offset="0.85"/>
						<GradientStop Color="Transparent" Offset="1.0"/>
					</LinearGradientBrush>
				</Grid.OpacityMask>
				<Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource SecondaryTextBrush}" Margin="0,-5,0,0" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
				<Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
			</Grid>
			<ScrollViewer x:Name="DailyScroller" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" Padding="0,0,0,0" Margin="0,0,0,32" SizeChanged="DailyView_SizeChanged" ScrollChanged="DailyView_ScrollChanged" MouseDoubleClick="DailyScroller_MouseDoubleClick" local:SmoothScrollBehavior.IsEnabled="True" local:SmoothScrollBehavior.ScrollStep="240.0" AutomationProperties.Name="Ten Day Temperature Graph" AutomationProperties.HelpText="Scroll horizontally to view the high and low temperature trends over the next 10 days">
				<ScrollViewer.OpacityMask>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Color="Transparent" Offset="0.0" />
						<GradientStop Color="White" Offset="0.03" />
						<GradientStop Color="White" Offset="0.97" />
						<GradientStop Color="Transparent" Offset="1.0" />
					</LinearGradientBrush>
				</ScrollViewer.OpacityMask>
				<ScrollViewer.Resources>
					<Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
						<Setter Property="MinHeight" Value="0"/>
						<Setter Property="Height" Value="4"/>
						<Setter Property="ContextMenu" Value="{x:Null}"/>
						<Setter Property="LayoutTransform">
							<Setter.Value>
								<ScaleTransform ScaleX="1.5" ScaleY="2.5"/>
							</Setter.Value>
						</Setter>
						<Setter Property="RenderTransform">
							<Setter.Value>
								<TranslateTransform Y="24"/>
							</Setter.Value>
						</Setter>
						<EventSetter Event="PreviewMouseLeftButtonDown" Handler="ScrollBar_PreviewMouseLeftButtonDown"/>
						<EventSetter Event="PreviewMouseLeftButtonUp" Handler="ScrollBar_PreviewMouseLeftButtonUp"/>
					</Style>
				</ScrollViewer.Resources>
				<Grid x:Name="DailyScrollGrid">
					<Canvas x:Name="DailyGraphCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Height="150" Margin="0,160,0,0">
						<Polygon x:Name="TempRibbonPolygon" Panel.ZIndex="0" Opacity="{DynamicResource DailyGraphRibbonOpacity}" />
						<Polyline x:Name="HighTempGraphLine" StrokeThickness="3" StrokeLineJoin="Round" Opacity=".4" Panel.ZIndex="1"/>
						<Polyline x:Name="LowTempGraphLine" StrokeThickness="3" StrokeLineJoin="Round" Opacity=".4" Panel.ZIndex="1"/>
						<Ellipse x:Name="ActiveHighTempDot" Width="12" Height="12" Opacity=".5" Panel.ZIndex="100" Visibility="Collapsed">
							<Ellipse.RenderTransform>
								<TranslateTransform x:Name="ActiveHighDotTransform" />
							</Ellipse.RenderTransform>
						</Ellipse>
						<Ellipse x:Name="ActiveLowTempDot" Width="12" Height="12" Opacity=".5" Panel.ZIndex="100" Visibility="Collapsed">
							<Ellipse.RenderTransform>
								<TranslateTransform x:Name="ActiveLowDotTransform" />
							</Ellipse.RenderTransform>
						</Ellipse>
					</Canvas>

					<ItemsControl x:Name="TenDayItemsControl" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Focusable="True" FocusVisualStyle="{x:Null}" RequestBringIntoView="TenDayItemsControl_RequestBringIntoView" ItemsSource="{Binding CurrentWeather.DailyData}" VerticalAlignment="Stretch">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<VirtualizingStackPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<StackPanel.Resources>
										<Style TargetType="TextBlock" BasedOn="{StaticResource BaseShadowText}"/>
									</StackPanel.Resources>
									<Border Width="170" CornerRadius="12" Margin="35,0,35,0" Padding="0,0,0,0" VerticalAlignment="Stretch" Background="Transparent">
										<StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
											<TextBlock Text="{Binding Date}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
											<Grid MaxWidth="150" Width="{Binding ActualWidth, ElementName=TenDayLocationText}" ClipToBounds="True" SizeChanged="LocationMarquee_SizeChanged" Background="Transparent" VerticalAlignment="Center" Height="16" Margin="0,0,0,2">
												<Canvas VerticalAlignment="Center" Height="16">
													<StackPanel Orientation="Horizontal" SizeChanged="LocationMarquee_SizeChanged">
														<StackPanel.RenderTransform>
															<TranslateTransform X="0"/>
														</StackPanel.RenderTransform>
														<TextBlock x:Name="TenDayLocationText" Text="{Binding Location, StringFormat='in {0}'}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
														<TextBlock Text="{Binding Text, ElementName=TenDayLocationText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="20,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
													</StackPanel>
												</Canvas>
											</Grid>
											<Grid Height="32">
												<Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="160" Margin="0,0,0,2">
													<TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
												</Viewbox>
											</Grid>
											<Grid Width="210" Margin="-20,2,-20,0">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
													<ColumnDefinition Width="*"/>
												</Grid.ColumnDefinitions>

												<StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,13,18">
													<Path Data="m 150.993,164.69593 c 18.50337,5.022 18.30458,4.96805 18.30458,4.96805 M 150.029,129.66587 c 18.51899,-6.25424 18.32133,-6.18749 18.32133,-6.18749 m -37.92558,-22.9104 C 141.9647,85.117008 141.84096,85.282678 141.84096,85.282678 m -49.39568,2.713665 c 0.003,-19.28479 0.003,-19.078015 0.003,-19.078015 M 56.043275,100.56798 C 44.503315,85.117008 44.62705,85.282678 44.62705,85.282678 M 35.245651,129.66587 C 16.726657,123.41163 16.92432,123.47838 16.92432,123.47838 m 16.903227,41.21755 c -18.50337,5.022 -18.304579,4.96805 -18.304579,4.96805 m 29.114047,15.92468 A 60.516072,60.516072 0 0 1 31.930596,148.48835 60.516072,60.516072 0 0 1 92.44667,87.972278 60.516072,60.516072 0 0 1 152.96274,148.48835 v 0 a 60.516072,60.516072 0 0 1 -12.70642,37.10031 M 0,185.68997 c 184.89334,0 184.89334,0 184.89334,0 m 42.21885,-6.71745 c 0,-94.867063 0,-94.420632 0,-94.420632 m -27.68186,26.266412 27.6167,-27.616683 v 0 l 27.6167,27.616683" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Height="14" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,2"/>
													<TextBlock Text="{Binding Sunrise}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
												</StackPanel>

												<Grid Grid.Column="1" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,0" Background="{DynamicResource IconVignetteBrush}">
													<ContentControl Content="{Binding IconPath}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
														<ContentControl.Style>
															<Style TargetType="ContentControl">
																<Setter Property="ContentTemplate">
																	<Setter.Value>
																		<DataTemplate>
																			<Image Source="{Binding Converter={StaticResource LottieToStaticConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
																		</DataTemplate>
																	</Setter.Value>
																</Setter>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding ViewModel.UseAnimatedIcons, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
																		<Setter Property="ContentTemplate">
																			<Setter.Value>
																				<DataTemplate>
																					<lottie:LottieAnimationView ResourcePath="{Binding Path=., IsAsync=True}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutoPlay="False" RepeatCount="-1" local:LottieScrollBehavior.TrackWith="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
																				</DataTemplate>
																			</Setter.Value>
																		</Setter>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</ContentControl.Style>
													</ContentControl>
												</Grid>

												<StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="13,0,0,18">
													<Path Data="m 150.993,164.69593 c 18.50337,5.022 18.30458,4.96805 18.30458,4.96805 M 150.029,129.66587 c 18.51899,-6.25424 18.32133,-6.18749 18.32133,-6.18749 m -37.92558,-22.9104 C 141.9647,85.117008 141.84096,85.282678 141.84096,85.282678 m -49.39568,2.713665 c 0.003,-19.28479 0.003,-19.078015 0.003,-19.078015 M 56.043275,100.56798 C 44.503315,85.117008 44.62705,85.282678 44.62705,85.282678 M 35.245651,129.66587 C 16.726657,123.41163 16.92432,123.47838 16.92432,123.47838 m 16.903227,41.21755 c -18.50337,5.022 -18.304579,4.96805 -18.304579,4.96805 m 29.114047,15.92468 A 60.516072,60.516072 0 0 1 31.930596,148.48835 60.516072,60.516072 0 0 1 92.44667,87.972278 60.516072,60.516072 0 0 1 152.96274,148.48835 v 0 a 60.516072,60.516072 0 0 1 -12.70642,37.10031 M 0,185.68997 c 184.89334,0 184.89334,0 184.89334,0 M 227.11219,80.529086 c 0,94.867064 0,94.420634 0,94.420634 m -27.68186,-26.26641 27.6167,27.61668 v 0 l 27.6167,-27.61668" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Height="14" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,1"/>
													<TextBlock Text="{Binding Sunset}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
												</StackPanel>
											</Grid>
											<TextBlock Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6">
												<Run Text="Hi: " FontSize="22"/>
												<Run Text="{Binding High, StringFormat={}{0}°}" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="26"/>
												<Run Text=" Lo: " FontSize="22"/>
												<Run Text="{Binding Low, StringFormat={}{0}°}" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="26"/>
											</TextBlock>
											<TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,6">
												<Run Text="Feels like: "/>
												<Run Text="{Binding FeelsLikeHigh, StringFormat={}{0}°}" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
												<Run Text=" / "/>
												<Run Text="{Binding FeelsLikeLow, StringFormat={}{0}°}" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
											</TextBlock>
											<TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,6">
                                                <Run Text="Humidity: "/>
                                                <Run Text="{Binding Humidity}" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/><Run Text="%" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/>
											</TextBlock>
											<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6" Height="18">
												<TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" Margin="0,0,5,0"><Run Text="Wind: "/><Run Text="{Binding WindSpeed}" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/><Run Text=" "/><Run Text="{Binding WindSpeedUnit, FallbackValue=mph}"/><Run Text=" "/><Run Text="{Binding WindDir}" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/></TextBlock>
												<Path Data="M 5,0 L 10,10 L 5,7 L 0,10 Z" Fill="{DynamicResource PrimaryTextBrush}" Width="10" Height="10" Stretch="Fill" RenderTransformOrigin="0.5,0.5" Margin="0,2,0,0" Tag="{Binding WindAngle}">
													<Path.RenderTransform>
														<RotateTransform Angle="{Binding Tag, RelativeSource={RelativeSource AncestorType=Path}}"/>
													</Path.RenderTransform>
												</Path>
											</StackPanel>
											<Grid Margin="0,0,0,6" Height="18">
												<TextBlock x:Name="DailyItemPrecipText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" HorizontalAlignment="Center">
													<Run Text="Precipitation: "/><Run Text="{Binding Precip}" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/><Run Text=" "/><Run Text="{Binding ViewModel.PrecipUnit, RelativeSource={RelativeSource AncestorType=Window}}"/>
												</TextBlock>
												<TextBlock x:Name="DailyItemPrecipChanceText" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" HorizontalAlignment="Center" Opacity="0">
													<Run Text="Precip. chance: "/><Run Text="{Binding PrecipChance}" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/><Run Text="%"/>
												</TextBlock>
											</Grid>
											<TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" HorizontalAlignment="Center" Height="18">
												<Run Text="UV index: "/>
												<Run Text="{Binding UvIndex}" FontWeight="Medium" Foreground="{DynamicResource PrimaryTextBrush}"/><Run Text="{Binding UvRating, StringFormat=' ({0})'}" FontSize="11" FontWeight="SemiBold"/>
											</TextBlock>

										</StackPanel>
									</Border>
								</StackPanel>
								<DataTemplate.Triggers>
									<DataTrigger Binding="{Binding ViewModel.ShowPrecipChance, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
										<DataTrigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="DailyItemPrecipText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
													<DoubleAnimation Storyboard.TargetName="DailyItemPrecipChanceText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.EnterActions>
										<DataTrigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="DailyItemPrecipText" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"/>
													<DoubleAnimation Storyboard.TargetName="DailyItemPrecipChanceText" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.ExitActions>
									</DataTrigger>
								</DataTemplate.Triggers>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</Grid>
			</ScrollViewer>

			<Canvas x:Name="DailyScaleCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Height="150" Width="40" Margin="0,160,0,0" Background="Transparent" local:AnimationHelper.FadeOnHover="True" local:AnimationHelper.HoverScrollTarget="{Binding ElementName=DailyScroller}"/>
		</Grid>

		<Grid x:Name="TenDayAgendaView" Visibility="Collapsed" Margin="0,0,0,-15">
			<Grid x:Name="KeyboardAgendaHighlightGroup" IsHitTestVisible="False" SnapsToDevicePixels="True" Opacity="0.7" Panel.ZIndex="1">
				<Grid.Style>
					<Style TargetType="Grid">
						<Setter Property="Visibility" Value="Collapsed"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=AgendaItemsControl}" Value="True">
								<Setter Property="Visibility" Value="Visible"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
				<Grid.OpacityMask>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Color="Transparent" Offset="0.0"/>
						<GradientStop Color="White" Offset="0.15"/>
						<GradientStop Color="White" Offset="0.85"/>
						<GradientStop Color="Transparent" Offset="1.0"/>
					</LinearGradientBrush>
				</Grid.OpacityMask>
				<Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource SecondaryTextBrush}" Margin="0,-5,0,0" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
				<Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
			</Grid>
			<ScrollViewer x:Name="AgendaScroller" CanContentScroll="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Background="Transparent" PanningMode="VerticalOnly" Margin="0,8,0,24" ScrollChanged="AgendaScroller_ScrollChanged" MouseDoubleClick="AgendaScroller_MouseDoubleClick" local:SmoothScrollBehavior.IsEnabled="True" local:SmoothScrollBehavior.ScrollStep="80.0" local:ScrollFadeBehavior.IsEnabled="True" AutomationProperties.Name="Ten Day Agenda">
				<ItemsControl x:Name="AgendaItemsControl" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Focusable="True" FocusVisualStyle="{x:Null}" RequestBringIntoView="AgendaItemsControl_RequestBringIntoView" ItemsSource="{Binding CurrentWeather.DailyData}" HorizontalAlignment="Stretch" Margin="4,0,4,0">
					<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<VirtualizingStackPanel Orientation="Vertical"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<StackPanel Margin="0,0,0,4" Height="76">
									<StackPanel.Resources>
										<Style TargetType="TextBlock" BasedOn="{StaticResource BaseShadowText}"/>
									</StackPanel.Resources>
								<TextBlock Text="{Binding AgendaDateHeader}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="Medium" Margin="0,0,0,2" Height="18"/>
								<Border Background="{DynamicResource AgendaCardBackgroundBrush}" CornerRadius="8" Padding="0,4,8,4" Height="56" Margin="0,0,6,0">
									<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="60"/>
												<ColumnDefinition Width="46"/>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="50"/>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>

										<Grid Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Center" Width="60" Margin="0,4,0,0">
											<Grid Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource IconVignetteBrush}">
												<ContentControl Content="{Binding IconPath}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
													<ContentControl.Style>
														<Style TargetType="ContentControl">
															<Setter Property="ContentTemplate">
																<Setter.Value>
																	<DataTemplate>
																		<Image Source="{Binding Converter={StaticResource LottieToStaticConverter}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
																	</DataTemplate>
																</Setter.Value>
															</Setter>
															<Style.Triggers>
																<DataTrigger Binding="{Binding ViewModel.UseAnimatedIcons, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
																	<Setter Property="ContentTemplate">
																		<Setter.Value>
																			<DataTemplate>
																				<lottie:LottieAnimationView ResourcePath="{Binding Path=., IsAsync=True}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutoPlay="False" RepeatCount="-1" local:LottieScrollBehavior.TrackWith="{Binding RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
																			</DataTemplate>
																		</Setter.Value>
																	</Setter>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</ContentControl.Style>
												</ContentControl>
											</Grid>

											<TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="50" LineHeight="10" LineStackingStrategy="BlockLineHeight" Margin="0,22,0,0" Visibility="{Binding Status, Converter={StaticResource SingleWordVisibilityConverter}, ConverterParameter=Multi}"/>

												<Grid MaxWidth="50" Width="{Binding ActualWidth, ElementName=TenDayAgendaStatusText}" ClipToBounds="True" SizeChanged="LocationMarquee_SizeChanged" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center" Height="14" Margin="0,22,0,0" Visibility="{Binding Status, Converter={StaticResource SingleWordVisibilityConverter}, ConverterParameter=Single}">
													<Canvas VerticalAlignment="Center" Height="14">
														<StackPanel Orientation="Horizontal" SizeChanged="LocationMarquee_SizeChanged">
															<StackPanel.RenderTransform>
																<TranslateTransform X="0"/>
															</StackPanel.RenderTransform>
															<TextBlock x:Name="TenDayAgendaStatusText" Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
															<TextBlock Text="{Binding Text, ElementName=TenDayAgendaStatusText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="15,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
														</StackPanel>
													</Canvas>
												</Grid>
											</Grid>

											<StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
												<TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left">
													<Run Text="Hi:" Foreground="{DynamicResource SecondaryTextBrush}"/> <Run Text="{Binding High, StringFormat={}{0}°}"/>
												</TextBlock>
												<TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left">
													<Run Text="Lo:" Foreground="{DynamicResource SecondaryTextBrush}"/> <Run Text="{Binding Low, StringFormat={}{0}°}"/>
												</TextBlock>
											</StackPanel>

										<Rectangle Grid.Column="2" Width="1" Height="28" Margin="4,0,4,0" VerticalAlignment="Center" Fill="{DynamicResource PrimaryTextBrush}">
											<Rectangle.OpacityMask>
												<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
														<GradientStop Color="Transparent" Offset="0.0" />
														<GradientStop Color="#60000000" Offset="0.5" />
														<GradientStop Color="Transparent" Offset="1.0" />
													</LinearGradientBrush>
												</Rectangle.OpacityMask>
											</Rectangle>

										<StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
											<TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" ToolTip="Humidity">
															<Run Text="H:" Foreground="{DynamicResource SecondaryTextBrush}"/> <Run Text="{Binding Humidity}"/><Run Text="%"/>
											</TextBlock>
											<Grid>
												<TextBlock x:Name="TenDayAgendaPrecipAmount" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" ToolTip="Precipitation amount / chance">
															<Run Text="P:" Foreground="{DynamicResource SecondaryTextBrush}"/> <Run Text="{Binding Precip}"/><Run Text="{Binding ViewModel.PrecipUnitShort, RelativeSource={RelativeSource AncestorType=Window}}"/>
												</TextBlock>
												<TextBlock x:Name="TenDayAgendaPrecipChance" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" ToolTip="Precipitation amount / chance" Opacity="0">
															<Run Text="P%:" Foreground="{DynamicResource SecondaryTextBrush}"/> <Run Text="{Binding PrecipChance}"/><Run Text="%"/>
												</TextBlock>
											</Grid>
										</StackPanel>

										<Rectangle Grid.Column="4" Width="1" Height="28" Margin="3,0,2,0" VerticalAlignment="Center" Fill="{DynamicResource PrimaryTextBrush}">
											<Rectangle.OpacityMask>
												<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
													<GradientStop Color="Transparent" Offset="0.0" />
													<GradientStop Color="#60000000" Offset="0.5" />
													<GradientStop Color="Transparent" Offset="1.0" />
												</LinearGradientBrush>
											</Rectangle.OpacityMask>
										</Rectangle>

										<StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Vertical" Margin="5,0,0,0" ToolTip="Wind">
											<TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"><Run Text="{Binding WindSpeed}"/><Run Text=" "/><Run Text="{Binding WindSpeedUnit, FallbackValue=mph}" Foreground="{DynamicResource SecondaryTextBrush}"/></TextBlock>
											<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
												<TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" Text="{Binding WindDir}" Margin="0,0,4,0" VerticalAlignment="Center"/>
												<Path Data="M 4,0 L 8,8 L 4,6 L 0,8 Z" Fill="{DynamicResource PrimaryTextBrush}" Width="8" Height="8" Stretch="Fill" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" Tag="{Binding WindAngle}">
													<Path.Effect>
														<DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.5"/>
													</Path.Effect>
													<Path.RenderTransform>
														<RotateTransform Angle="{Binding Tag, RelativeSource={RelativeSource AncestorType=Path}}"/>
													</Path.RenderTransform>
												</Path>
											</StackPanel>
										</StackPanel>
									</Grid>
								</Border>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<Grid HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="16" Margin="10,30,-4,20" Panel.ZIndex="10" UseLayoutRounding="False">
				<Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" IsHitTestVisible="False" Fill="{DynamicResource PrimaryTextBrush}">
					<Rectangle.OpacityMask>
						<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
							<GradientStop Color="Transparent" Offset="0.0" />
							<GradientStop Color="#40000000" Offset="0.5" />
							<GradientStop Color="Transparent" Offset="1.0" />
						</LinearGradientBrush>
					</Rectangle.OpacityMask>
				</Rectangle>
				<ScrollBar x:Name="AgendaScrollBar" Orientation="Vertical"
                           Minimum="0" 
                           Maximum="{Binding ScrollableHeight, ElementName=AgendaScroller, Mode=OneWay}"
                           ViewportSize="{Binding ViewportHeight, ElementName=AgendaScroller, Mode=OneWay}"
                           Background="Transparent"
                           BorderBrush="Transparent"
                           Padding="0"
                           ContextMenu="{x:Null}"
                           Scroll="AgendaScrollBar_Scroll"
                           PreviewMouseLeftButtonDown="ScrollBar_PreviewMouseLeftButtonDown"
                           Template="{StaticResource CustomScrollBarTemplate}" />
			</Grid>
		</Grid>

		<Border x:Name="TenDayAgendaIconBorder" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="Hand" ToolTip="Switch to agenda view" AutomationProperties.Name="Switch to vertical agenda view" MouseLeftButtonUp="AgendaIcon_MouseLeftButtonUp" Padding="5" Panel.ZIndex="10" Margin="0,-5,-5,0">
			<Path Data="M 3,2 C 2,2 1,3 1,4 L 1,20 C 1,21 2,22 3,22 L 13,22 C 14,22 15,21 15,20 L 15,4 C 15,3 14,2 13,2 Z M 5,6 L 11,6 M 5,10 L 11,10 M 5,14 L 11,14 M 5,18 L 11,18" StrokeThickness="1.25" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" Style="{StaticResource HoverGlowPath}"/>
		</Border>
		<Border x:Name="TenDayGraphIconBorder" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="Hand" ToolTip="Switch to graph view" AutomationProperties.Name="Switch to horizontal graph view" MouseLeftButtonUp="GraphIcon_MouseLeftButtonUp" Padding="5" Panel.ZIndex="10" Margin="0,-5,-5,0">
			<Path Data="M 2,16 H 18 M 2,16 V 2 M 5,12 L 9,7 L 13,10 L 17,3" StrokeThickness="1.25" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" Style="{StaticResource HoverGlowPath}"/>
		</Border>
	</Grid>
</UserControl>