<Window x:Class="SkyPeek.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SkyPeek"
        mc:Ignorable="d" Focusable="True" FocusVisualStyle="{x:Null}"
        SizeToContent="Height" Width="244" Background="Transparent" Style="{x:Null}"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        ResizeMode="NoResize" Topmost="True" Deactivated="Window_Deactivated"
        UseLayoutRounding="{DynamicResource OsLayoutRounding}"
        TextOptions.TextFormattingMode="{DynamicResource OsTextFormattingMode}"
        TextOptions.TextRenderingMode="{DynamicResource OsTextRenderingMode}">
	<Window.Resources>
		<local:FontSizeAddConverter x:Key="FontAdder" />

		<Style x:Key="TrayMenuFocusVisual">
			<Setter Property="Control.Template">
				<Setter.Value>
					<ControlTemplate>
						<Border BorderBrush="{DynamicResource PrimaryTextBrush}" 
                                BorderThickness="2" 
                                CornerRadius="6" 
                                Margin="10,5,10,5" 
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                Opacity="0.85"/>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DismissFocusVisual">
			<Setter Property="Control.Template">
				<Setter.Value>
					<ControlTemplate>
						<Border BorderBrush="{DynamicResource PrimaryTextBrush}" 
                                BorderThickness="2" 
                                CornerRadius="4" 
                                Margin="-1" 
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True"
                                Opacity="0.85"/>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
			<Setter Property="TextOptions.TextFormattingMode" Value="{DynamicResource OsTextFormattingMode}" />
			<Setter Property="TextOptions.TextRenderingMode" Value="{DynamicResource OsTextRenderingMode}" />
			<Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />
		</Style>
		<Style TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="20,5"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FocusVisualStyle" Value="{StaticResource TrayMenuFocusVisual}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Margin="0,1">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="RootBorder" Property="Background" Value="#40808080"/>
								<Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>
	<Border x:Name="WindowBorder" CornerRadius="8" BorderThickness="1" Margin="20">
		<Border.CacheMode>
			<BitmapCache RenderAtScale="1" SnapsToDevicePixels="True"/>
		</Border.CacheMode>
		<Border.Background>
			<RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
				<GradientStop x:Name="GradientCenter" Color="#FA38383D" Offset="0.0" />
				<GradientStop x:Name="GradientEdge" Color="#E6151518" Offset="1.0" />
			</RadialGradientBrush>
		</Border.Background>
		<Border.Effect>
			<DropShadowEffect x:Name="WindowShadow" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
		</Border.Effect>
		<Border.RenderTransform>
			<TranslateTransform x:Name="MenuTranslateTransform" X="0" Y="0"/>
		</Border.RenderTransform>
		<StackPanel Margin="3,8,3,8">
			<Button x:Name="UpdateButton" Click="Update_Click" Visibility="Collapsed">
				<Grid Margin="0,2,15,2">
					<StackPanel Orientation="Horizontal">
						<Grid Width="16" Margin="0,0,12,0">
							<TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" FontWeight="{DynamicResource TrayIconFontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,-1,0">
								<TextBlock.Triggers>
									<EventTrigger RoutedEvent="Loaded">
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetProperty="Opacity"
																 From="1.0" To="0.35"
																 Duration="0:0:0.8"
																 AutoReverse="True"
																 RepeatBehavior="Forever"/>
											</Storyboard>
										</BeginStoryboard>
									</EventTrigger>
								</TextBlock.Triggers>
							</TextBlock>
						</Grid>
						<TextBlock Text="Update available"
						           FontSize="{Binding Source={x:Static SystemFonts.MenuFontSize}, Converter={StaticResource FontAdder}, ConverterParameter=2}" 
						           FontFamily="Segoe UI Variable, Segoe UI"
						           VerticalAlignment="Center"/>
					</StackPanel>

					<Button x:Name="DismissUpdateButton" 
                            Click="DismissUpdate_Click" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center" 
                            Padding="0" 
                            Margin="0,0,-24,0"
                            BorderThickness="0"
                            Background="Transparent"
                            Opacity="0"
                            Cursor="Hand"
                            FocusVisualStyle="{StaticResource DismissFocusVisual}"
                            ToolTip="Dismiss update alert">
						<TextBlock Text="&#xE711;" 
						           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
						           FontSize="12" 
						           FontWeight="SemiBold" 
						           Foreground="#FF6B6B"/>
						<Button.Style>
							<Style TargetType="Button">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding ElementName=UpdateButton, Path=IsMouseOver}" Value="True">
										<Setter Property="Visibility" Value="Visible"/>
										<DataTrigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.15">
														<DoubleAnimation.EasingFunction>
															<QuadraticEase EasingMode="EaseOut"/>
														</DoubleAnimation.EasingFunction>
													</DoubleAnimation>
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.EnterActions>
									</DataTrigger>
									<DataTrigger Binding="{Binding ElementName=UpdateButton, Path=IsKeyboardFocused}" Value="True">
										<Setter Property="Visibility" Value="Visible"/>
										<DataTrigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.7" Duration="0:0:0.15">
														<DoubleAnimation.EasingFunction>
															<QuadraticEase EasingMode="EaseOut"/>
														</DoubleAnimation.EasingFunction>
													</DoubleAnimation>
												</Storyboard>
											</BeginStoryboard>
										</DataTrigger.EnterActions>
									</DataTrigger>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter Property="Visibility" Value="Visible"/>
										<Setter Property="Opacity" Value="1.0"/>
									</Trigger>
									<Trigger Property="IsKeyboardFocused" Value="True">
										<Setter Property="Visibility" Value="Visible"/>
										<Setter Property="Opacity" Value="1.0"/>
									</Trigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="4">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter Property="Background" Value="#40FF6B6B"/>
									</Trigger>
									<Trigger Property="IsKeyboardFocused" Value="True">
										<Setter Property="Background" Value="#40FF6B6B"/>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</Grid>
			</Button>
			<Button x:Name="SettingsButton" Click="Settings_Click" >
				<StackPanel Orientation="Horizontal" Margin="0,2,15,2">
					<Grid Width="16" Margin="0,0,12,0">
						<TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" FontWeight="{DynamicResource TrayIconFontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Grid>
					<TextBlock Text="Settings"
					           FontSize="{Binding Source={x:Static SystemFonts.MenuFontSize}, Converter={StaticResource FontAdder}, ConverterParameter=2}" 
					           FontFamily="Segoe UI Variable, Segoe UI"
					           VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
			<Button x:Name="ClearAlertsButton" Click="ViewAlerts_Click">
				<StackPanel Orientation="Horizontal" Margin="0,0,12,0">
					<Grid Width="16" Margin="0,0,12,0">
						<Path Data="M 12,2 L 22,20 H 2 Z M 12,8 V 14 M 12,17 V 17.1" 
						      Stroke="{DynamicResource PrimaryTextBrush}" 
						      StrokeThickness="1.25" 
						      Fill="Transparent"
						      Width="15" 
						      Height="15" 
						      Stretch="Uniform" 
						      StrokeStartLineCap="Round" 
						      StrokeEndLineCap="Round" 
						      StrokeLineJoin="Round"
						      HorizontalAlignment="Center"
						      VerticalAlignment="Center" />
					</Grid>
					<TextBlock Text="View alerts"
		           FontSize="{Binding Source={x:Static SystemFonts.MenuFontSize}, Converter={StaticResource FontAdder}, ConverterParameter=2}" 
		           FontFamily="Segoe UI Variable, Segoe UI"
		           VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
			<Rectangle Height="1" Width="174" Margin="0,2,0,2" Fill="{DynamicResource PrimaryTextBrush}">
				<Rectangle.OpacityMask>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Color="Transparent" Offset="0.0" />
						<GradientStop Color="#60000000" Offset="0.5" />
						<GradientStop Color="Transparent" Offset="1.0" />
					</LinearGradientBrush>
				</Rectangle.OpacityMask>
			</Rectangle>
			<Button x:Name="ExitButton" Click="Exit_Click">
				<StackPanel Orientation="Horizontal" Margin="0,2,15,2">
					<Grid Width="16" Margin="0,0,12,0">
						<TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" FontWeight="{DynamicResource TrayIconFontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Grid>
					<TextBlock Text="Exit SkyPeek"
					           FontSize="{Binding Source={x:Static SystemFonts.MenuFontSize}, Converter={StaticResource FontAdder}, ConverterParameter=2}" 
					           FontFamily="Segoe UI Variable, Segoe UI"
					           VerticalAlignment="Center"/>
				</StackPanel>
			</Button>
		</StackPanel>
	</Border>
</Window>